<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cs476_parking</name>
  <version>0.1.0</version>
  <description>COM S 4760/5760 demo: a bicycle-model car parallel parks, driven by messages. A sim node integrates the car on /cmd and publishes /pose, a planner node publishes the reverse-in maneuver, a viewer node draws the street.</description>
  <maintainer email="nok@iastate.edu">Nok Wongpiromsarn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <depend>cs476_interfaces</depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
