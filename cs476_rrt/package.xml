<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cs476_rrt</name>
  <version>0.1.0</version>
  <description>COM S 4760/5760: RRT in a ROS 2 node. Students write nearest, steer and extend in skeleton.py; the planner node loads a world, grows the tree, publishes the path on /path (nav_msgs/Path) and writes path.json, tree.json and tree.png.</description>
  <maintainer email="nok@iastate.edu">Nok Wongpiromsarn</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ros2launch</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-shapely</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
